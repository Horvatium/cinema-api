# Kopiraj v .env in izpolni. Pravega .env nikoli ne commitaj.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cinema
# false za lokalno bazo brez TLS (Docker, testi)
DB_SSL=false

# Avtentikacija
JWT_SECRET=change-me

# Strežnik
PORT=5000
# Raven beleženja: trace, debug, info (privzeto), warn, error, silent
# LOG_LEVEL=info
# Časovni pas kina; časi predstav so shranjeni kot lokalni stenski čas
CINEMA_TIMEZONE=Europe/Ljubljana

# Varnost (neobvezno)
# Dovoljeni izvori za CORS, ločeni z vejicami; privzeto kinoplex.si,
# Vercelovi predogledi cinema-web in localhost
# CORS_ORIGINS=https://www.kinoplex.si,https://kinoplex.si
# Največ neuspešnih prijav na IP v 15 minutah (privzeto 10)
# LOGIN_RATE_LIMIT=10
# Največ registracij in ponovnih pošiljanj potrditve na IP v uri (privzeto 5)
# REGISTER_RATE_LIMIT=5

# Stripe (uporabi testne ključe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# E-pošta prek Resend (neobvezno; brez ključa se ne pošilja)
RESEND_API_KEY=
EMAIL_FROM=KinoPlex <noreply@example.com>
