# Copy to .env and fill in. Never commit the real .env.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cinema
# Set to false for a local database without TLS (Docker, tests)
DB_SSL=false

# Auth
JWT_SECRET=change-me

# Server
PORT=5000
# Time zone of the cinema; screening times are stored as local wall-clock time
CINEMA_TIMEZONE=Europe/Ljubljana

# Stripe (use test-mode keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email via Resend (optional; emails are skipped when unset)
RESEND_API_KEY=
EMAIL_FROM=KinoPlex <noreply@example.com>
